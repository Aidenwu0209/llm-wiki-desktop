{
  "name": "llm-wiki-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "desktop:dev": "tauri dev",
    "start": "npm run desktop:dev",
    "typecheck": "tsc --build --pretty",
    "test": "npm run test:welcome && npm run typecheck && npm run test:rust",
    "test:welcome": "tsx --tsconfig tsconfig.app.json scripts/test-welcome-onboarding.tsx",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "npm run typecheck && vite build",
    "benchmark:submission": "tsx scripts/benchmark/run-submission-benchmark.ts",
    "benchmark:submission:summary": "tsx scripts/benchmark/summarize-submission-benchmark.ts",
    "prebuild:app": "node scripts/clean-stale-bundles.mjs",
    "build:app": "tauri build",
    "smoke:macos": "bash scripts/smoke/macos-clean-profile.sh",
    "smoke:windows": "powershell -ExecutionPolicy Bypass -File scripts/smoke/windows-dev.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.3"
  }
}
