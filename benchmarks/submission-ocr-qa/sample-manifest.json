{
  "schema_version": 1,
  "benchmark_id": "submission-ocr-qa",
  "name": "OCR + ERNIE + Evidence Wiki submission benchmark",
  "description": "Acceptance-style benchmark manifest for validating OCR/PDF parsing artifacts, evidence-grounded answers, citation coverage, unsupported claims, and traceability breaks.",
  "samples": [
    {
      "sample_id": "mock-paper",
      "source_path": "raw/sources/mock-submission.pdf",
      "source_type": "pdf",
      "modalities": ["pdf_text", "embedded_image", "table", "heading_tree"],
      "expected_artifacts": [
        "sources/mock-submission.md",
        "artifacts/mock-paper/ocr.json",
        "artifacts/mock-paper/chunks.jsonl"
      ],
      "expected_evidence_ids": [
        "mock-paper:p1:title",
        "mock-paper:p1:parser",
        "mock-figure:p2:label",
        "mock-table:p3:gpu-hours",
        "mock-artifact:chunks"
      ]
    },
    {
      "sample_id": "mock-negative-evidence",
      "source_path": "raw/sources/mock-redaction-note.png",
      "source_type": "image",
      "modalities": ["image_text", "refusal"],
      "expected_artifacts": ["artifacts/mock-negative-evidence/ocr.json"],
      "expected_evidence_ids": ["mock-trace:missing-source"]
    }
  ],
  "fixture_ocr_artifacts": [
    {
      "artifact_path": "artifacts/demo-source-0001/markdown.md",
      "manifest_path": "artifacts/demo-source-0001/manifest.json",
      "source_path": "raw/inbox/sample-project.md",
      "source_id": "DEMO-0001",
      "parser": "PaddleOCR-VL-1.5",
      "parser_model": "PaddleOCR-VL-1.5",
      "parser_version": "synthetic-demo",
      "page_count": 3,
      "chunk_count": 4,
      "source_sha256": "fixture-demo-source-sha256",
      "artifact_sha256": "fixture-demo-artifact-sha256",
      "latency_ms": 120,
      "limitations": [
        "fixture benchmark artifact metadata only; no live OCR request was performed",
        "sample demo artifact omits real page images and parser-side timing logs"
      ]
    },
    {
      "artifact_path": "artifacts/mock-paper/ocr.json",
      "manifest_path": "artifacts/mock-paper/manifest.json",
      "source_path": "raw/sources/mock-submission.pdf",
      "source_id": "MOCK-PAPER",
      "parser": "PaddleOCR-VL-1.5",
      "parser_model": "PaddleOCR-VL-1.5",
      "parser_version": "fixture-benchmark",
      "page_count": 3,
      "chunk_count": 6,
      "source_sha256": "fixture-mock-paper-sha256",
      "artifact_sha256": "fixture-mock-paper-artifact-sha256",
      "latency_ms": 120,
      "limitations": [
        "fixture metadata for CI and local no-key benchmark runs"
      ]
    }
  ],
  "required_metrics": [
    "parse_success_rate",
    "markdown_generated",
    "json_generated",
    "manifest_valid",
    "chunk_count",
    "citation_coverage",
    "unsupported_claim_count",
    "traceability_break_count",
    "ernie_answer_latency_ms",
    "ocr_latency_ms",
    "end_to_end_latency_ms",
    "no_evidence_refusal_rate"
  ],
  "environment_contract": {
    "vault_required": true,
    "ernie_key_env": "AI_STUDIO_API_KEY",
    "ernie_live_optional": true,
    "local_evidence_must_run_without_ernie_key": true
  }
}
